language js

// Text a person reads comes from the locale catalog, rendered with
// useTranslations(). Complements Biome's style/noJsxLiterals, which covers
// JSX text but not string children in braces, display props or toasts.
or {
  // {'Hello'} and {`Welcome ${name}`} as a JSX child.
  JsxExpressionChild(expression=$text) where {
    $text <: or {
      JsStringLiteralExpression(),
      JsTemplateExpression()
    },
    $text <: r"(?s).*\p{L}\p{L}.*",
    register_diagnostic(span=$text, message="Text a person reads must come from the locale catalog: render it with useTranslations().", severity="error")
  },
  // label='Display name', title={'Details'}.
  JsxAttribute(name=$name, initializer=$init) where {
    $name <: r"^(?:label|title|placeholder|aria-label|alt|tooltip|description|helpText|helperText|emptyText|emptyMessage|heading|subheading|subtitle|confirmLabel|enabledTooltip|disabledTooltip)$",
    $init <: JsxAttributeInitializerClause(value=or {
      JsxString() as $text,
      JsxExpressionAttributeValue(expression=or {
        JsStringLiteralExpression(),
        JsTemplateExpression()
      } as $text)
    }),
    $text <: r"(?s).*\p{L}\p{L}.*",
    // Example values in placeholders: https://example.com, localhost, ~/data.
    if ($name <: r"^placeholder$") {
      $text <: not r"^['\"`](?:\S*(?:://|…)\S*|[~.]\S*|[a-z][a-z0-9.\-_/]*)['\"`]$"
    },
    register_diagnostic(span=$init, message="Text a person reads must come from the locale catalog: render it with useTranslations().", severity="error")
  },
  // toast('Saved'), toast.success(`Saved ${name}`).
  or {
    `toast($msg)`,
    `toast.$method($msg)` where { $method <: r"^(?:success|info|warning|error|loading)$" }
  } as $call where {
    // The first argument is a string or template literal with words in it.
    $msg <: r"(?s)^['\"`][^'\"`]*\p{L}\p{L}.*",
    register_diagnostic(span=$msg, message="Text a person reads must come from the locale catalog: render it with useTranslations().", severity="error")
  }
}
