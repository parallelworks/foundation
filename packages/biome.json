{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/lint/fixtures", "!**/CHANGELOG.md", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Checkbox", "Radio", "Switch"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.tsx", "**/*.stories.tsx", "ui/src/ai/stories/**", "ui/src/test/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["ui/src/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": {
              "level": "error",
              "options": {
                "allowedStrings": ["(", ")", "/", ":", ".", "…", "%", "·", "•", "●", "+", "*", "#"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.stories.tsx",
        "**/*.test.tsx",
        "ui/src/ai/stories/**",
        "ui/src/test/**",
        "ui/src/components/Provider.tsx",
        "ui/src/ai/strings.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
