{
  "name": "@parallelworks/ui",
  "version": "0.18.0",
  "description": "React UI components: a theme contract, icons, primitives, lists, forms, a job graph, a code editor, a log viewer, a file explorer and an AI chat, each on its own subpath",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parallelworks/foundation.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./icons": "./src/icons.tsx",
    "./theme": "./src/theme/index.ts",
    "./theme.css": "./src/styles/theme.css",
    "./base.css": "./src/styles/base.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./styles.css": "./src/styles.css",
    "./logviewer": "./src/logviewer/index.ts",
    "./logviewer.css": "./src/logviewer/logviewer.css",
    "./graph": "./src/graph/index.ts",
    "./form": "./src/form/index.ts",
    "./editor": "./src/editor/index.ts",
    "./list": "./src/list/index.ts",
    "./file-explorer": "./src/file-explorer/index.ts",
    "./ai": "./src/ai/index.ts",
    "./ai/openai": "./src/ai/adapter/openai/index.ts",
    "./ai/mock": "./src/ai/adapter/mock/index.ts",
    "./ai.css": "./src/ai/ai.css"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./icons": {
        "types": "./dist/icons.d.ts",
        "import": "./dist/icons.js"
      },
      "./theme": {
        "types": "./dist/theme/index.d.ts",
        "import": "./dist/theme/index.js"
      },
      "./theme.css": "./dist/styles/theme.css",
      "./base.css": "./dist/styles/base.css",
      "./fonts.css": "./dist/styles/fonts.css",
      "./styles.css": "./dist/styles.css",
      "./logviewer": {
        "types": "./dist/logviewer/index.d.ts",
        "import": "./dist/logviewer/index.js"
      },
      "./logviewer.css": "./dist/logviewer/logviewer.css",
      "./graph": {
        "types": "./dist/graph/index.d.ts",
        "import": "./dist/graph/index.js"
      },
      "./form": {
        "types": "./dist/form/index.d.ts",
        "import": "./dist/form/index.js"
      },
      "./editor": {
        "types": "./dist/editor/index.d.ts",
        "import": "./dist/editor/index.js"
      },
      "./list": {
        "types": "./dist/list/index.d.ts",
        "import": "./dist/list/index.js"
      },
      "./file-explorer": {
        "types": "./dist/file-explorer/index.d.ts",
        "import": "./dist/file-explorer/index.js"
      },
      "./ai": {
        "types": "./dist/ai/index.d.ts",
        "import": "./dist/ai/index.js"
      },
      "./ai/openai": {
        "types": "./dist/ai/adapter/openai/index.d.ts",
        "import": "./dist/ai/adapter/openai/index.js"
      },
      "./ai/mock": {
        "types": "./dist/ai/adapter/mock/index.d.ts",
        "import": "./dist/ai/adapter/mock/index.js"
      },
      "./ai.css": "./dist/ai/ai.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && pnpm build:types && pnpm build:css",
    "build:types": "tsc -p tsconfig.build.json && node scripts/declaration-extensions.mjs",
    "build:css": "mkdir -p dist/styles dist/logviewer dist/ai && cp src/styles/theme.css src/styles/base.css src/styles/fonts.css src/styles/*.woff2 dist/styles/ && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify && cp src/logviewer/logviewer.css dist/logviewer/ && cp src/ai/ai.css dist/ai/",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint:package": "publint --strict",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepublishOnly": "pnpm clean && pnpm build",
    "typecheck": "tsc --noEmit",
    "storybook": "pnpm build:css && storybook dev -p 6006",
    "build-storybook": "pnpm build:css && storybook build"
  },
  "peerDependencies": {
    "formik": "^2.4.9",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "^5.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/luxon": "^3.7.1",
    "anser": "^2.3.5",
    "classnames": "^2.5.1",
    "fast-deep-equal": "^3.1.3",
    "framer-motion": "^12.40.0",
    "js-yaml": "^4.3.0",
    "luxon": "^3.7.2",
    "re-resizable": "^6.11.2",
    "react-animate-height": "^3.2.4",
    "react-icons": "5.6.0",
    "react-loading-skeleton": "^3.5.0",
    "react-number-format": "^5.4.5",
    "react-popper": "^2.3.0",
    "react-tooltip": "^6.0.7",
    "react-zoom-pan-pinch": "^4.0.3",
    "shiki": "^3.19.0",
    "streamdown": "^2.5.0",
    "swr": "^2.4.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@parallelworks/workflow-parser": "^0.6.0",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "formik": "^2.4.9",
    "jsdom": "^26.1.0",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "^5.5.1",
    "publint": "^0.3.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.5.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    },
    "monaco-yaml": {
      "optional": true
    }
  }
}
