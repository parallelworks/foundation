{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "last-release-sha": "75083af75c7f56ffb4655e61d7fa436edfef4182",
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "go",
      "component": "foundation",
      "include-component-in-tag": false,
      "exclude-paths": ["packages", ".github"],
      "pull-request-title-pattern": "chore: release ${version}"
    },
    "packages/problem": {
      "release-type": "node",
      "component": "problem",
      "pull-request-title-pattern": "chore(problem): release ${version}"
    },
    "packages/i18n": {
      "release-type": "node",
      "component": "i18n",
      "pull-request-title-pattern": "chore(i18n): release ${version}"
    },
    "packages/lint": {
      "release-type": "node",
      "component": "lint",
      "pull-request-title-pattern": "chore(lint): release ${version}"
    }
  }
}
